mod llama-cpp 'llama-cpp/Justfile'
mod ninfer 'ninfer/Justfile'
mod vllm 'vllm/Justfile'

# List engine modules.
help:
  @just --list

# Load every engine image into the current Docker daemon; ninfer comes last, as it exists only on x86_64 Linux and builds for minutes on its first load.
image-load:
  just llama-cpp image-load
  just vllm image-load
  just ninfer image-load

# Run the image tests of the engines that have one (ninfer); loader tests are `just dev::docker-images-check`.
test:
  just ninfer image-test
