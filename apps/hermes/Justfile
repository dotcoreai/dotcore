import '../../nix/docker-images/dockerfile.just'

# Local tag the image workflow runs against; deployments use the derivation's own reference.
workflow_tag := "dotcore/hermes:dev"

# List Hermes app recipes.
help:
    @just --list

# Load the image, tag it for the image workflow, and qualify it.
[group('image')]
image-test:
    cd ../.. && reference=$(nix run .#{{image_package}} | jq -r .reference) && docker tag "$reference" {{workflow_tag}}
    cd ../.. && node apps/hermes/image-workflow.mjs
