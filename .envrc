# Inherit .envrc from parent directories if it exists
source_up_if_exists

watch_file flake.nix
watch_file flake.lock

use flake "."

watch_file .env.base
watch_file .env.local
watch_file dev/workspace-environment.mjs

if ! node dev/workspace-environment.mjs; then
  return 1
fi

dotenv .direnv/dotcore-development.env
