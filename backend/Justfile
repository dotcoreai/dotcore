set positional-arguments

# List backend module recipes.
help:
  @just --list

# Create the simulated development site.
bootstrap:
  cd .. && just dev::site-init simulated simulated

# Run rust formatting
format:
  cargo fmt --all

# Check rust formatting without changing files.
format-check:
  cargo fmt --all --check

# Run rust lint checks.
clippy:
  # Tests may bound their waits on real time, so only production code is held to the clock.
  cargo clippy --locked --workspace --all-targets --all-features -- -D warnings -A clippy::disallowed_methods

  # Production build without `test-support`, which every test build enables; it rejects direct
  # Tokio timers outside a reasoned allow (`clippy.toml`).
  cargo clippy --locked --workspace --lib --bins -- -D warnings

# Run rust tests.
test *args:
  cargo nextest run --locked --workspace "$@"

  # Run doctests separately since nextest doesn't support them yet
  # https://github.com/nextest-rs/nextest/issues/16
  cargo test --locked --workspace --doc

# Run tests with the diagnostic profile (JUnit report).
test-diagnostics *args:
  cargo nextest run --locked --workspace --profile diagnostic "$@"

# Run all backend workspace tests through the Nix test derivation.
# Always runs the suite: --rebuild when the output is already in the store (the
# derivation is deterministic, see doInstallCargoArtifacts in nix/backend.nix);
# --rebuild refuses fresh derivations, so fall back to a plain build there.
[script]
test-nix:
  set -euo pipefail
  cd ..
  out=$(nix eval --raw .#backend.tests.default)
  if [ -e "$out" ]; then
    exec nix build --rebuild .#backend.tests.default --print-build-logs
  else
    exec nix build .#backend.tests.default --print-build-logs
  fi

# Fail unless nvml-wrapper is declared in exactly one Cargo.toml (backend/nvml).
# Every other backend consumer reaches NVML through dotcore-nvml::open().
[script]
gate-nvml-single-owner:
  set -euo pipefail
  matches=$(grep -rl --include=Cargo.toml nvml-wrapper . | grep -v /target/ | sed 's|^\./||' | sort || true)
  expected='nvml/Cargo.toml'
  if [ "$matches" != "$expected" ]; then
    echo "nvml single-owner violation: nvml-wrapper declared in: [$matches] (expected only: $expected)" >&2
    exit 1
  fi
  echo "nvml single-owner gate: OK (nvml-wrapper only in $expected)"

# Run the NVIDIA hardware tests (profile `nvidia`); extra arguments narrow the selection.
test-nvidia *args:
  cargo nextest run --locked --workspace -P nvidia --run-ignored only "$@"

# Run the NVIDIA tests whose model needs a whole RTX 5090 (profile `nvidia5090`); run them only
# when no other workload uses the card. Extra arguments narrow the selection.
test-nvidia-5090 *args:
  cargo nextest run --locked --workspace -P nvidia5090 --run-ignored only "$@"

# Run the NVIDIA GB10 (DGX Spark) hardware tests (profile `gb10`); extra arguments narrow the selection.
test-gb10 *args:
  cargo nextest run --locked --workspace -P gb10 --run-ignored only "$@"

# Run the Apple Silicon hardware tests on a macOS host: GPU observation, and llama.cpp on Metal
# end to end through the native runtime, whose workloads need the profile's launcher.
test-apple *args: build-launcher
  cargo nextest run --locked --workspace -P apple --run-ignored only "$@"

# Run the tests gated on a native-architecture Docker daemon (profile `docker`); extra arguments narrow the selection.
test-docker *args:
  cargo nextest run --locked --workspace -P docker --run-ignored only "$@"

# Fail unless every ignored test is a hardware test of exactly one class or a marked non-hardware
# test (`_helper`, `_stub`, `net_`), and every hardware test is ignored. Lists only; needs no hardware.
[script]
gate-hardware-coverage:
  set -euo pipefail
  # The only home of the non-hardware ignored markers.
  allowed='test(~_helper) | test(~_stub) | test(~net_)'
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  # `--locked --workspace` reuses the `just test` build; `list` exits 0 on an empty selection, so
  # the checks compare content. Output: one sorted `binary-id test-name` line per test.
  list() {
    out=$1; shift
    cargo nextest list --locked --workspace --message-format oneline "$@" | sort > "$dir/$out"
  }
  list ignored --run-ignored only
  list hw_ignored --run-ignored only -E 'test(~hw_)'
  list hw_all --run-ignored all -E 'test(~hw_)'
  list allow --run-ignored only -E "$allowed"
  list docker --run-ignored only -E 'test(~hw_docker_)'
  list nvidia --run-ignored only -E 'test(~hw_nvidia_)'
  list nvidia5090 --run-ignored only -E 'test(~hw_nvidia5090_)'
  list gb10 --run-ignored only -E 'test(~hw_gb10_)'
  list apple --run-ignored only -E 'test(~hw_apple_)'
  sort -u "$dir/hw_ignored" "$dir/allow" > "$dir/covered"
  sort -u "$dir/docker" "$dir/nvidia" "$dir/nvidia5090" "$dir/gb10" "$dir/apple" > "$dir/classes"
  fail=0
  report() { # title, file of offending lines
    if [ -s "$2" ]; then
      echo "hardware coverage gate: $1:" >&2
      sed 's/^/  /' "$2" >&2
      fail=1
    fi
  }
  comm -23 "$dir/ignored" "$dir/covered" > "$dir/unmarked"
  report "ignored tests that are neither hardware (hw_<class>_) nor marked non-hardware (_helper, _stub, net_)" "$dir/unmarked"
  comm -13 "$dir/hw_ignored" "$dir/hw_all" > "$dir/leaking"
  report "hardware tests (hw_) that are not ignored and would run in 'just test'" "$dir/leaking"
  comm -3 "$dir/hw_ignored" "$dir/classes" > "$dir/unclassed"
  report "hardware tests (hw_) outside the hw_docker_, hw_nvidia_, hw_nvidia5090_, hw_gb10_ and hw_apple_ classes" "$dir/unclassed"
  if [ "$fail" -ne 0 ]; then
    exit 1
  fi
  echo "hardware coverage gate: OK ($(wc -l < "$dir/hw_ignored" | tr -d ' ') hardware tests, $(wc -l < "$dir/allow" | tr -d ' ') marked non-hardware ignored tests)"

# Build all backend workspace packages with locked dependencies.
build:
  cargo build --locked --workspace

# Remove Rust build output.
clean:
  cargo clean

# Build generated protobuf bindings without handwritten backend consumers.
build-proto:
  cargo build --locked --package dotcore-proto

# Build the launcher binary; pass `--release` for the release profile.
build-launcher profile="":
  cargo build --locked {{profile}} --package dotcore-launcher

# Start the development backend with Cargo.
run-dev: build-launcher
  exec cargo run --locked --package dotc --bin dotc -- server start

# Start the development backend with Cargo's release profile.
run-dev-release: (build-launcher "--release")
  exec cargo run --locked --release --package dotc --bin dotc -- server start

# Fail unless the development site exists, which the backend needs to start.
[no-exit-message]
bootstrap-check:
  @[ -f "${DOTCORE_SITE_DIR:?DOTCORE_SITE_DIR is unset; enter the workspace direnv shell}/site.yaml" ] || { echo "backend is not bootstrapped (no development site at $DOTCORE_SITE_DIR); run \`just backend::bootstrap\`" >&2; exit 1; }

# Start the nix built backend.
run-nix:
  cd .. && exec nix run .#dotc -- server start

# Start the selected development backend.
run:
  @case "${DOTCORE_BACKEND_RUN_MODE-dev}" in \
    dev) just run-dev ;; \
    dev-release) just run-dev-release ;; \
    nix) just run-nix ;; \
    *) printf 'DOTCORE_BACKEND_RUN_MODE must be one of: dev, dev-release, nix; got: %s\n' "${DOTCORE_BACKEND_RUN_MODE}" >&2; exit 1 ;; \
  esac

# Run all backend validation operations (format, clippy, test).
check:
  just format
  just ci-check

# Run the backend validations CI runs, without changing files.
ci-check: ci-lint ci-test

# Run the backend's static checks CI runs, without changing files: formatting, clippy and the NVML gate.
ci-lint:
  just format-check
  just clippy
  just gate-nvml-single-owner

# Run the backend tests CI runs and the hardware coverage gate; a part such as `1/2` runs only that share of the tests.
ci-test part="":
  just test {{ if part == "" { "" } else { "--partition count:" + part } }}
  just gate-hardware-coverage

# Publish the backend crates to crates.io with your `cargo login` token after a dry run and your confirmation, waiting out the new-crate rate limit; a rerun skips versions already published, and extra arguments go to `cargo publish`.
[script]
publish *args:
  #!/usr/bin/env bash
  set -euo pipefail
  source ../dev/confirm.sh
  retry_seconds="${DOTCORE_PUBLISH_RETRY_SECONDS:-600}"
  index=$(mktemp)
  log=$(mktemp)
  trap 'rm -f "$index" "$log"' EXIT

  # Succeeds when crates.io holds this crate version. Reads the public sparse index, never a token.
  is_published() {
    local name="$1" version="$2" prefix status
    case ${#name} in
      1) prefix=1 ;;
      2) prefix=2 ;;
      3) prefix="3/${name:0:1}" ;;
      *) prefix="${name:0:2}/${name:2:2}" ;;
    esac
    status=$(curl -sS -o "$index" -w '%{http_code}' "https://index.crates.io/$prefix/$name")
    case "$status" in
      200) jq -n -e --arg version "$version" '[inputs | select(.vers == $version)] | length > 0' < "$index" > /dev/null ;;
      404) return 1 ;;
      *) echo "crates.io index answered $status for $name; try again later" >&2; exit 1 ;;
    esac
  }

  # Splits the workspace crates into the ones to publish and `--exclude` flags for the published ones.
  scan() {
    pending=()
    skipped=()
    excludes=()
    while read -r name version; do
      if is_published "$name" "$version"; then
        skipped+=("  $name $version")
        excludes+=(--exclude "$name")
      else
        pending+=("  $name $version")
      fi
    done < <(cargo metadata --locked --no-deps --format-version 1 | jq -r '.packages[] | "\(.name) \(.version)"' | sort)
  }

  scan
  if [ ${#pending[@]} -eq 0 ]; then
    echo "every backend crate version is already on crates.io; nothing to publish"
    exit 0
  fi

  cargo publish --locked --workspace ${excludes[@]+"${excludes[@]}"} --dry-run "$@"

  summary=("crates to publish:" "${pending[@]}")
  if [ ${#skipped[@]} -gt 0 ]; then
    summary+=("already published, skipped:" "${skipped[@]}")
  fi
  confirm_or_exit "publishing" "Publish these crates to crates.io?" "${summary[@]}"

  # The dry run verified every crate, so the upload skips rebuilding them on each attempt.
  until cargo publish --locked --workspace ${excludes[@]+"${excludes[@]}"} --no-verify "$@" 2>&1 | tee "$log"; do
    # crates.io answers 429 once too many new crates were published recently.
    if ! grep -q 'status 429' "$log"; then
      exit 1
    fi
    echo "crates.io rate limit reached; retrying the remaining crates in ${retry_seconds}s" >&2
    sleep "$retry_seconds"
    scan
  done
