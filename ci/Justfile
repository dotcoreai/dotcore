# List CI module recipes.
help:
  @just --list

# Lint the GitHub workflows with actionlint, without changing files.
lint:
  cd .. && actionlint

# Fail when commits in a range still carry the unreviewed or private prefix, listing each one; defaults to the commits not yet on main.
check-commit-prefixes range="origin/main..HEAD":
  cd .. && ci/check-commit-prefixes.sh "{{range}}"

# Run every area's CI validations, without changing files; needs `just frontend::bootstrap` first.
check:
  cd .. && just ci::lint
  cd .. && just proto::ci-check
  cd .. && just frontend::ci-check
  cd .. && just backend::ci-check
  cd .. && just dev::ci-check
  cd .. && just dev::catalog-check
  cd .. && just installer::ci-check
