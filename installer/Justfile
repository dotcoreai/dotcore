# List installer recipes.
help:
  @just --list

# Check the installer script with shellcheck as POSIX sh.
lint:
  shellcheck -s sh install.sh

# Run the installer regression cases with a pseudo-terminal and fake tools.
test:
  python3 test/install-test.py

# Run all installer validations.
check: lint test

# Run the installer validations CI runs, without changing files.
ci-check: check
