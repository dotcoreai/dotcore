
# List protobuf module recipes.
help:
  @just --list

# Check protobuf formatting without changing files.
format:
  buf format --diff --exit-code

# Run protobuf lint checks.
lint:
  buf lint

# Build the protobuf module descriptor.
build:
  buf build

# Regenerate TypeScript through Buf, then Rust bindings without backend consumers.
generate:
  buf generate
  just ../backend/build-proto

# Run all protobuf validation operations (format, lint, build).
check: format lint build

# Run the protobuf validations CI runs, without changing files.
ci-check: check generate-check

# Fail when the committed TypeScript bindings differ from a fresh generation.
generate-check:
  #!/usr/bin/env bash
  set -euo pipefail
  out=$(mktemp -d)
  trap 'rm -rf "$out"' EXIT
  buf generate -o "$out/proto"
  if ! diff -r "$out/frontend/src/gen" ../frontend/src/gen; then
    echo 'generated protobuf bindings are stale; run `just proto::generate` and commit the result' >&2
    exit 1
  fi
